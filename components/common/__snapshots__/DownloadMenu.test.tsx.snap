exports[`DownloadMenu exports > writes a print window for PDF with search and keyword highlights 1`] = `
"
        <!DOCTYPE html>
        <html>
          <head>
            <title>news_transcript</title>
            <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;600;700&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
            <style>
              body { 
                font-family: 'Hind Siliguri', 'Kalpurush', 'SolaimanLipi', 'Inter', -apple-system, sans-serif; 
                padding: 40px; 
                color: #1e293b; 
                background-color: #ffffff;
              }
              @media print {
                @page { margin: 20mm; }
                body { 
                  -webkit-print-color-adjust: exact; 
                  print-color-adjust: exact; 
                  padding: 0;
                }
              }
            </style>
          </head>
          <body>
            
        <div style="border-bottom: 2px solid #6366f1; padding-bottom: 20px; margin-bottom: 30px; display: flex; justify-content: space-between; align-items: center;">
          <div>
            <h1 style="margin: 0; font-size: 24px; font-weight: 900; color: #4338ca;">LI CELL STUDIO</h1>
            <p style="margin: 5px 0 0 0; font-size: 10px; font-weight: 900; color: #64748b; letter-spacing: 2px;">TRANSCRIPTION EXPORT (SEARCH HIGHLIGHTED)</p>
          </div>
          <div style="text-align: right;">
            <p style="margin: 0; font-size: 10px; font-weight: 700; color: #94a3b8;">DATE: 10/22/2026</p>
            <p style="margin: 5px 0 0 0; font-size: 10px; font-weight: 700; color: #94a3b8;">FILE: news</p>
          </div>
        </div>
      
            <div id="transcript-content">
              <p style="margin-bottom: 15px; line-height: 1.6; font-size: 13px;">[00:05] <strong style="color: #4338ca; font-weight: 700;">Speaker 1:</strong> হ্যালো, সীমান্ত এলাকায় আজ <mark style="background-color: #ef4444; color: white; padding: 0 4px; border-radius: 4px; font-weight: bold;">মাদক</mark> উদ্ধার হয়েছে। </p><p style="margin-bottom: 15px; line-height: 1.6; font-size: 13px;">[০১:০৭] <strong style="color: #4338ca; font-weight: 700;">বক্তা ২:</strong> জি, <mark style="background-color: #ef4444; color: white; padding: 0 4px; border-radius: 4px; font-weight: bold;">Border</mark> Guard দল কাজ করছে </p><p style="margin-bottom: 15px; line-height: 1.6; font-size: 13px;">(00:59) এবং </p><p style="margin-bottom: 15px; line-height: 1.6; font-size: 13px;">[1:02:03] পরে আবার। </p><p style="margin-bottom: 15px; line-height: 1.6; font-size: 13px;">[00:58] <strong style="color: #4338ca; font-weight: 700;">Speaker 1:</strong> শেষ <mark style="background-color: #f97316; color: white; padding: 0 2px; <mark style="background-color: #ef4444; color: white; padding: 0 4px; border-radius: 4px; font-weight: bold;">border</mark>-radius: 2px;">কথা</mark>।</p>
            </div>
          </body>
        </html>
      "
`;

