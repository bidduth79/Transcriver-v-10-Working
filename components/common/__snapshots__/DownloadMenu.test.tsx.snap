exports[`DownloadMenu exports > exports Word with and without keyword highlight > highlighted 1`] = `"<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'><head><meta charset='utf-8'><title>Transcript</title><style>body { font-family: "Hind Siliguri", sans-serif; }</style></head><body>[00:05] <strong style="color: #4338ca;">Speaker 1:</strong> হ্যালো, সীমান্ত এলাকায় আজ <span style="background-color: #ef4444; color: white; font-weight: bold;">মাদক</span> উদ্ধার হয়েছে। <br>[০১:০৭] <strong style="color: #4338ca;">বক্তা ২:</strong> জি, <span style="background-color: #ef4444; color: white; font-weight: bold;">Border</span> Guard দল কাজ করছে <br>(00:59) এবং <br>[1:02:03] পরে আবার। <br>[00:58] <strong style="color: #4338ca;">Speaker 1:</strong> শেষ কথা।</body></html>"`;

